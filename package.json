{
  "name": "twitchy-stream-shield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:commands": "TWITCHY_DEV_COMMANDS=1 tsx src/index.ts",
    "demo:events": "tsx src/web/demo-events.ts",
    "obs:setup": "tsx scripts/obs-setup.ts",
    "pregauntlet": "npm run ocr:build",
    "gauntlet": "tsx scripts/gauntlet.ts",
    "ocr:build": "node scripts/build-ocr-vision.mjs",
    "fixture:ocr": "swift scripts/generate-ocr-fixture.swift --benchmark && swift scripts/generate-ocr-fixture.swift --benchmark --small",
    "fixture:ocr:matrix": "swift scripts/generate-ocr-fixture.swift --matrix",
    "bench:ocr": "npm run ocr:build && tsx scripts/bench-ocr.ts",
    "pretest": "node scripts/build-ocr-vision.mjs --if-supported",
    "test": "tsx --test 'src/**/*.test.ts' 'scripts/**/*.test.ts' 'tools/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.18.0"
  }
}
