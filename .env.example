# Twitch application client ID
TWITCH_CLIENT_ID=
# Twitch bot user access token (Twitch CLI scopes: user:read:chat user:write:chat user:bot)
TWITCH_BOT_TOKEN=
# Twitch bot account user ID
TWITCH_BOT_USER_ID=
# Broadcaster channel user ID
TWITCH_BROADCASTER_ID=
# OBS WebSocket URL
OBS_WS_URL=ws://127.0.0.1:4455
# OBS WebSocket password
OBS_WS_PASSWORD=
# OpenAI API key for compiling rules
OPENAI_API_KEY=
